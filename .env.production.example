# Production environment: copy this file to .env.production on the Mac Mini.
APP_ENV=production
FRONTEND_ORIGIN=http://YOUR_MAC_IP

# PostgreSQL
POSTGRES_USER=homeserver
POSTGRES_PASSWORD=replace-with-a-strong-production-password
POSTGRES_DB=home_server

# Application login
APP_USERNAME=replace-with-your-username
APP_PASSWORD_HASH=replace-with-a-password-hash
APP_SESSION_SECRET=replace-with-a-long-random-secret

# Weather
WEATHER_LOCATION_NAME="Mesa, AZ"
WEATHER_LATITUDE=33.39
WEATHER_LONGITUDE=-111.84
WEATHER_TIMEZONE=America/Phoenix
